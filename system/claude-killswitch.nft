# Kill-switch для Claude / Anthropic.
# Прямые подключения к Claude через Wi-Fi (wl*) и кабель (en*) запрещены.
# Работать с Claude можно только через прокси/VPN: трафик VPN-клиента идёт
# на ваш VPN-сервер, а не на адреса ниже, поэтому правило его не задевает.
#
# 160.79.104.0/21  — сеть Anthropic (claude.ai, api.anthropic.com и т.д.)
# 35.190.46.17     — downloads.claude.ai (обновления Claude Code, Google Cloud)
# 2607:6bc0::/48   — IPv6 Anthropic
# Проверить актуальность: getent ahostsv4 claude.ai downloads.claude.ai

table inet claude_killswitch
delete table inet claude_killswitch
table inet claude_killswitch {
  set anthropic4 { type ipv4_addr; flags interval; elements = { 160.79.104.0/21, 35.190.46.17 } }
  set anthropic6 { type ipv6_addr; flags interval; elements = { 2607:6bc0::/48 } }
  chain out {
    type filter hook output priority 0; policy accept;
    oifname { "wl*", "en*" } meta l4proto tcp ip daddr @anthropic4 reject with tcp reset
    oifname { "wl*", "en*" } ip daddr @anthropic4 reject
    oifname { "wl*", "en*" } meta l4proto tcp ip6 daddr @anthropic6 reject with tcp reset
    oifname { "wl*", "en*" } ip6 daddr @anthropic6 reject
  }
}

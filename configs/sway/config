# Sway: тайловый рабочий стол в духе Hyprland, но лёгкий (подходит для старых ноутбуков).
# Win = $mod. Главное: Win+Enter терминал, Win+D меню, Win+Q закрыть,
# Win+1..9 рабочие столы, Win+Backspace плавающий терминал с подсолнухом.

set $mod Mod4
set $term kitty
set $menu wofi --show drun

# --- палитра из wallust (обои anime-mono) ---
set $bg     #201F23
set $fg     #CCC7D4
set $accent #5F18B1
set $accent2 #471285
set $muted  #47454A

# Обои: однотонный фон. Чтобы поставить картинку — положи её в ~/.config/sway/wallpaper.jpg,
# закомментируй первую строку, раскомментируй вторую и нажми Win+Shift+C.
output * bg #201F23 solid_color
# output * bg ~/.config/sway/wallpaper.jpg fill

font pango:FantasqueSansM Nerd Font 11
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 4
smart_gaps on
titlebar_padding 1

#                       border    bg       text   indicator child_border
client.focused          $accent   $accent  $fg    $accent2  $accent
client.focused_inactive $muted    $bg      $fg    $muted    $muted
client.unfocused        $muted    $bg      #797581 $muted   $muted
client.urgent           #AE2B5B   #AE2B5B  $fg    #AE2B5B   #AE2B5B

# --- ввод ---
input type:keyboard {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# --- программы ---
bindsym $mod+Return exec $term
bindsym $mod+BackSpace exec $term --class floatterm sh -c 'fastfetch; exec bash'
for_window [app_id="floatterm"] floating enable, resize set 950 520, move position center
bindsym $mod+d exec $menu
bindsym $mod+e exec nautilus
bindsym $mod+b exec firefox
bindsym $mod+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Выйти из Sway?' -B 'Да' 'swaymsg exit'
bindsym $mod+Shift+c reload
bindsym $mod+l exec swaylock -f -c 201F23

# скриншоты: Print весь экран, Win+Shift+S область (в буфер и ~/Изображения)
bindsym Print exec grim ~/Изображения/screen-$(date +%F_%H-%M-%S).png
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | tee ~/Изображения/screen-$(date +%F_%H-%M-%S).png | wl-copy

# --- окна ---
floating_modifier $mod normal
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+f fullscreen
bindsym $mod+Space floating toggle
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+w layout tabbed
bindsym $mod+s layout toggle split
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 30px
    bindsym Right resize grow width 30px
    bindsym Up resize shrink height 30px
    bindsym Down resize grow height 30px
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
# Alt+Tab по-виндовому: следующее окно на рабочем столе
bindsym Mod1+Tab focus next
bindsym Mod1+Shift+Tab focus prev

# --- рабочие столы ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Tab workspace back_and_forth

# --- функциональные клавиши ноутбука ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- плавающие по умолчанию ---
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# --- автозапуск ---
bar swaybar_command waybar
exec mako
# VPN-клиент с локальным прокси (например Happ). Раскомментируй, если используешь:
# exec happ
exec nm-applet --indicator
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec swayidle -w timeout 600 'swaylock -f -c 201F23' timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f -c 201F23'
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec_always gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark

include /etc/sway/config.d/*

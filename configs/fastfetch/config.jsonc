{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Свою картинку-логотип: положи PNG в ~/.config/fastfetch/logo.png и замени блок logo на
    // "logo": { "source": "~/.config/fastfetch/logo.png", "type": "kitty-direct", "width": 18, "height": 9 }
    "logo": { "padding": { "top": 1 } },
    "display": { "separator": " -> " },
    "modules": [
        "break",
        "title",
        { "type": "custom", "format": " ─────────────────────────── " },
        { "type": "os", "key": " " },
        { "type": "kernel", "key": " " },
        { "type": "wm", "key": " " },
        { "type": "terminal", "key": " " },
        { "type": "cpu", "key": " " },
        { "type": "memory", "key": " " },
        { "type": "disk", "key": "󰋊 ", "folders": "/" },
        { "type": "battery", "key": "󰁹 " },
        { "type": "custom", "format": " ─────────────────────────── " },
        { "type": "colors", "symbol": "circle" }
    ]
}
